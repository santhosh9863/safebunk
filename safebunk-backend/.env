# Linways endpoints
LINWAYS_BASE_URL=https://sfcv4.linways.com
LINWAYS_ACCOUNTS_URL=https://accounts.linways.com

# Google OAuth (placeholder - no real secrets)
GOOGLE_CLIENT_ID=placeholder-google-client-id

# Probe config
PROBE_TIMEOUT_MS=10000
MAX_REDIRECT_DEPTH=10

# === Phase 5 - Production Settings ===

# Port
PORT=3000

# Backend JWT secret (32+ chars). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Set this to a fixed value so sessions survive restarts
BACKEND_JWT_SECRET=

# Session encryption key (32 bytes, base64-encoded). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: Set this so encrypted session files survive restarts
SESSION_ENCRYPTION_KEY=

# CORS origin for Flutter app
CORS_ORIGIN=*

# Build version
BUILD_VERSION=5.0.0

# Log level: DEBUG, INFO, WARN, ERROR, SILENT
LOG_LEVEL=INFO

# HTTPS (set to true and provide cert paths for production)
HTTPS_ENABLED=false
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# SSO Proxy callback base URL (must match backend's public URL for Google OAuth redirect)
# For local dev: http://10.12.38.38:3000
# For production: https://your-app.railway.app
SSO_CALLBACK_BASE=http://10.12.38.38:3000
