// PULSE Reports — Prisma schema (Phase 1).
// Dev: SQLite. Target: PostgreSQL — see docs/REPORTS_SCHEMA.md.
// String cuid IDs, DateTime and enum types are chosen so the provider can be
// swapped to postgresql with no column rework.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Report {
  id        String    @id @default(cuid())
  code      String    @unique
  studentId String
  title     String
  description String
  category  String?
  location  String?
  imageUrl  String?
  priority  String    @default("MEDIUM")
  status    String    @default("SUBMITTED")
  assignedDepartment String?

  // AI predictions — nullable, never trusted for authorization.
  aiCategory   String?
  aiPriority   String?
  aiConfidence Float?
  aiDepartment String?
  aiReasons    String?
  aiOverrideBy String?
  aiOverrideAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  events ReportEvent[]
  attachments Attachment[]

  @@index([studentId, createdAt])
}

// Uploaded report photos. Image BYTES live in object storage (Firebase
// Storage); only ownership + object metadata are kept here. `reportId` is null
// until the attachment is claimed by a report the same student owns.
model Attachment {
  id          String   @id @default(cuid())
  studentId   String
  reportId    String?
  storagePath String   @unique
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([reportId])
}

model ReportEvent {
  id       String @id @default(cuid())
  reportId String
  type     String
  actorId  String?
  actorRole String  @default("SYSTEM")
  remark   String?
  aiPayload String?
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

// Lookup tables — created empty in Phase 1, populated in later phases.
model Category {
  id     String @id @default(cuid())
  name   String @unique
  active Boolean @default(true)
}

model Location {
  id     String @id @default(cuid())
  block  String
  floor  String?
  room   String?
  label  String
}

model Department {
  id     String @id @default(cuid())
  name   String @unique
  active Boolean @default(true)
}
